// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`atMedia > matches snapshot 1`] = `
{
  "2xl": "@media (width >= 96rem)",
  "lg": "@media (width >= 64rem)",
  "md": "@media (width >= 48rem)",
  "sm": "@media (width >= 40rem)",
  "width >= 1024rpx": "@media (width >= calc(1024 * 0.0625rem))",
  "width >= 1280rpx": "@media (width >= calc(1280 * 0.0625rem))",
  "width >= 1536rpx": "@media (width >= calc(1536 * 0.0625rem))",
  "width >= 640rpx": "@media (width >= calc(640 * 0.0625rem))",
  "width >= 768rpx": "@media (width >= calc(768 * 0.0625rem))",
  "xl": "@media (width >= 80rem)",
}
`;

{
  "name": "solarwindcss",
  "version": "0.37.10",
  "description": "Design tokens for Vicinage & StyleX",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chbybnwr/solarwindcss.git"
  },
  "homepage": "https://github.com/chbybnwr/solarwindcss",
  "bugs": {
    "url": "https://github.com/chbybnwr/solarwindcss/issues"
  },
  "funding": "https://github.com/sponsors/chbybnwr",
  "keywords": [
    "css",
    "solarwindcss",
    "stylex",
    "vicinage"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/tokens/*.js",
    "./*.js": "./dist/tokens/*.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepack": "npm run build && npm pkg delete scripts packageManager devDependencies",
    "check": "npm run typecheck && npm run test -- --coverage && npm run lint && npm run format -- --check && npm run spellcheck",
    "build": "tsdown",
    "compile": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --build",
    "test": "vite build && vitest run",
    "lint": "eslint ./",
    "format": "prettier ./",
    "spellcheck": "cspell ./"
  },
  "packageManager": "pnpm@11.17.0",
  "dependencies": {
    "@stylexjs/stylex": "~0.19.0"
  },
  "devDependencies": {
    "@chbybnwr/tsconfig": "github:chbybnwr/tsconfig#v0.1.1",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.2.0",
    "@eslint/markdown": "^8.0.3",
    "@stylexjs/eslint-plugin": "~0.19.0",
    "@stylexjs/unplugin": "~0.19.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@txe/eslint-plugin-x": "~0.2.1",
    "@types/node": "^26.1.1",
    "@typescript-eslint/parser": "^8.63.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.23",
    "cspell": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "tsdown": "~0.22.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}

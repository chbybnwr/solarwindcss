{
  "name": "solarwindcss",
  "version": "0.36.10",
  "description": "Design tokens for Vicinage & StyleX",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chbybnwr/solarwindcss.git"
  },
  "homepage": "https://github.com/chbybnwr/solarwindcss",
  "bugs": {
    "url": "https://github.com/chbybnwr/solarwindcss/issues"
  },
  "funding": "https://github.com/sponsors/chbybnwr",
  "keywords": [
    "css",
    "solarwindcss",
    "stylex",
    "vicinage"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/tokens/*.js",
    "./*.js": "./dist/tokens/*.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepack": "npm run build && npm pkg delete scripts packageManager devDependencies",
    "check": "npm run typecheck && npm run test -- --coverage && npm run lint && npm run format -- --check && npm run spellcheck",
    "build": "tsdown",
    "compile": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --build",
    "test": "vite build && vitest run",
    "lint": "eslint ./",
    "format": "prettier ./",
    "spellcheck": "cspell ./"
  },
  "packageManager": "pnpm@11.1.1",
  "dependencies": {
    "@stylexjs/stylex": "~0.18.3"
  },
  "devDependencies": {
    "@chbybnwr/tsconfig": "github:chbybnwr/tsconfig#v0.1.1",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.2.0",
    "@eslint/markdown": "^8.0.1",
    "@stylexjs/eslint-plugin": "^0.18.3",
    "@stylexjs/unplugin": "^0.18.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@txe/eslint-plugin-x": "~0.2.1",
    "@types/node": "^25.9.0",
    "@typescript-eslint/parser": "^8.59.4",
    "@typescript/native-preview": "7.0.0-dev.20260415.1",
    "@vitest/coverage-v8": "^4.1.6",
    "@vitest/eslint-plugin": "^1.6.17",
    "cspell": "^10.0.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  }
}
